# Copy to .env.prod (git ignores it) and edit. Used by compose.yaml.
# Values here are placeholders; never commit real ones.

# Address and port the server listens on, inside the container.
NOCK_HOST=0.0.0.0
NOCK_PORT=8000
# SQLite file of the rooms and accounts, on the nock_data volume.
NOCK_DATABASE=/data/nock.sqlite3
# Secret of the /ops pages, 32 to 256 characters (letters, digits, _ and -).
# Make one: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty turns the operator pages off.
NOCK_OPERATOR_TOKEN=
# Public https address players open (the domain of Caddy, NOCK_DOMAIN); the
# links of the sign-in e-mails start with it.
NOCK_PUBLIC_URL=https://nock.example.org
# Your mail server.
NOCK_SMTP_HOST=smtp.example.org
# starttls, tls or none. Leave the port out to take 587, 465 or 25 by security.
NOCK_SMTP_SECURITY=starttls
NOCK_SMTP_PORT=587
# Mail login: set both or neither.
NOCK_SMTP_USER=nock@example.org
NOCK_SMTP_PASSWORD=change-me
# Sender address of the e-mails.
NOCK_SMTP_FROM=nock@example.org
