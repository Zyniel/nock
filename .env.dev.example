# Copy to .env.dev (git ignores it) and edit. Used by compose.dev.yaml.
# Values here are placeholders; never commit real ones.

# Address and port the server listens on, inside the container.
NOCK_HOST=0.0.0.0
NOCK_PORT=8000
# SQLite file of the rooms and accounts, on the nock_dev_data volume.
NOCK_DATABASE=/data/nock.sqlite3
# Secret of the /ops pages, 32 to 256 characters (letters, digits, _ and -).
# Make one: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty turns the operator pages off.
NOCK_OPERATOR_TOKEN=dev-operator-token-change-me-0123456789
# Address players open; the links of the sign-in e-mails start with it.
NOCK_PUBLIC_URL=http://localhost:8000
# Mail server: Mailpit, started by compose.dev.yaml.
NOCK_SMTP_HOST=mailpit
NOCK_SMTP_PORT=1025
# starttls, tls or none (Mailpit takes none).
NOCK_SMTP_SECURITY=none
# Sender address of the e-mails.
NOCK_SMTP_FROM=nock@localhost.test
