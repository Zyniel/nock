# Copy to /srv/nock/deploy/backup.env on the server, fill in, then:
#   sudo chown root:root backup.env && sudo chmod 600 backup.env
# Used by backup.sh and restore-test.sh (docs/oracle-setup.md, step 9).
# Keep RCLONE_CONFIG_NOCKBACKUP_PASSWORD's original password in a password
# manager: without it the backups cannot be decrypted.

# Oracle Object Storage, through its S3-compatible API.
# <namespace>: Profile menu > Tenancy > "Object storage namespace".
# Keys: Profile menu > My profile > Customer secret keys > Generate secret key.
RCLONE_CONFIG_OCI_TYPE=s3
RCLONE_CONFIG_OCI_PROVIDER=Other
RCLONE_CONFIG_OCI_ENDPOINT=https://<namespace>.compat.objectstorage.eu-paris-1.oraclecloud.com
RCLONE_CONFIG_OCI_REGION=eu-paris-1
RCLONE_CONFIG_OCI_ACCESS_KEY_ID=
RCLONE_CONFIG_OCI_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OCI_NO_CHECK_BUCKET=true

# Encryption: rclone's crypt remote on top of the bucket "nock-backups".
# The value is the output of: rclone obscure '<a long random password>'
RCLONE_CONFIG_NOCKBACKUP_TYPE=crypt
RCLONE_CONFIG_NOCKBACKUP_REMOTE=oci:nock-backups
RCLONE_CONFIG_NOCKBACKUP_PASSWORD=

# Optional: a check URL (for example from healthchecks.io, free) that is called
# after each successful backup; the service e-mails you when a day is missed.
BACKUP_PING_URL=
