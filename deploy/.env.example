# Copy to /srv/nock/deploy/.env on the server, fill in, then: chmod 600 .env
# Never commit the filled file. Keep a copy of the secrets in a password manager.

# The public name of the site, as in the DNS record (no https://, no slash).
NOCK_DOMAIN=nock.example.org

# Operator dashboard /ops (spec 038). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to turn /ops off.
NOCK_OPERATOR_TOKEN=

# Accounts and sign-in e-mails (spec 033, V1). Leave all of these commented out
# until the release that has accounts, and the mail provider is set up. Setting
# only one of NOCK_PUBLIC_URL and NOCK_SMTP_HOST stops the server at start.
# NOCK_PUBLIC_URL=https://nock.example.org
# NOCK_SMTP_HOST=smtp-relay.brevo.com
# NOCK_SMTP_PORT=587
# NOCK_SMTP_SECURITY=starttls
# NOCK_SMTP_USER=
# NOCK_SMTP_PASSWORD=
# NOCK_SMTP_FROM=connexion@example.org
